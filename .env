# Copia este archivo a .env.
# Modo demo (frontend sin backend, datos en memoria): deja EXPO_PUBLIC_DEMO_MODE=true.
# Cuenta demo: demo@kavi.app / demo1234 (o crea una en la pantalla de registro).
EXPO_PUBLIC_DEMO_MODE=true

# Para conectar con Supabase: pon EXPO_PUBLIC_DEMO_MODE=false y completa estos valores
# (Project Settings → API). Solo la anon key: nunca la service_role key (NFR-5).
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
