# Copia este archivo a .env (que NO se versiona, NFR-5).

# false = backend real de Supabase. true = backend en memoria, sin red,
# con la cuenta demo@kavi.app / demo1234.
EXPO_PUBLIC_DEMO_MODE=true

# Proyecto Supabase (Project Settings → API).
# Solo la anon key: nunca la service_role key (NFR-5).
# Antes de usarlo, aplica el esquema: supabase/schema.sql (ver README).
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
