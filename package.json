  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:listado": "jest --json --outputFile=.jest-results.json && python3 reports/pruebas/generar-que-se-probo.py .jest-results.json",
